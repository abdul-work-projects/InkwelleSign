# Base URL used in signing links and emails
APP_URL=http://localhost:4000

# Optional SMTP transport. When unset, all mail is captured in the in-app Outbox.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# MAIL_FROM="Inkwell eSign <no-reply@example.com>"

# Storage / database location (defaults to ./storage)
# INKWELL_DATA_DIR=/var/lib/inkwell

# Passwordless "Test sign in" button for the seeded demo account.
#   unset -> available outside production only
#   on    -> available (hosted evaluation instances only)
#   off   -> never available
# It is also hidden automatically unless `npm run seed` has been run.
# DEMO_LOGIN=off
